          "stringUnit" : {
            "state" : "translated",
            "value" : "Frost Bar"
          }
        }
      }
    },
    "Frost Bar: hidden icons appear in a glass panel below the menu bar." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
