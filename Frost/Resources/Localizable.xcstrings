    },
    "Frost’s separator isn’t in the menu bar.\nFrost will retry automatically. If this keeps happening, try relaunching Frost." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frost 的分隔符不在菜单栏中。\nFrost 会自动重试；若一直如此，请尝试重新启动 Frost。"
          }
