    },
    "Frost can’t hide icons on macOS %lld. An update is on the way." : {
      "comment" : "Notice shown on a macOS version Frost can't manage the menu bar on; the number is the macOS major version",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frost 目前无法在 macOS %lld 上隐藏图标。更新即将推出。"
          }
        }
      }
    },
    "Frost needs Accessibility; Screen Recording is optional." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frost 需要辅助功能权限；屏幕录制权限是可选的。"
          }
        }
      }
    },
    "Frost needs the Accessibility permission to read and move icons. Screen Recording is optional: it shows real images of the icons." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frost 需要辅助功能权限来读取和移动图标。屏幕录制权限是可选的：用于显示图标的真实图像。"
          }
        }
      }
    },
    "Frost, update available" : {
      "comment" : "Accessibility label of the Frost menu bar icon while an update is waiting to be installed",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frost，有可用更新"
