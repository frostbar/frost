    "Existing icons start out in the Hidden section. Open the layout editor and drag the ones you use often back to Visible." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现有图标默认都在「隐藏」分区。打开布局编辑器，把常用的图标拖回「可见」分区。"
          }
        }
      }
    },
    "Existing icons stay in Always Hidden until access is granted, then move to Hidden automatically (Screen Recording requires relaunching Frost)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权前现有图标暂留「始终隐藏」，授权后自动移到「隐藏」（屏幕录制需重启 Frost）。"
          }
        }
      }
    },
    "Frost" : {
      "shouldTranslate" : false
