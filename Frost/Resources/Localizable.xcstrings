        }
      }
    },
    "The Frost Bar needs the Accessibility permission." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frost Bar 需要辅助功能权限。"
          }
        }
      }
    },
    "The Frost Bar needs the Accessibility permission. Until it’s granted, hidden icons expand in the menu bar." : {
