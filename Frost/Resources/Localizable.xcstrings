{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (doesn’t fit in the menu bar)" : {
      "comment" : "Tile tooltip; the argument is the icon name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（菜单栏空间不足，无法显示）"
          }
        }
      }
    },
    "%@ (fixed by the system; can’t be moved)" : {
      "comment" : "Tile tooltip; the argument is the icon name",
