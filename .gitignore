.DS_Store
build/
DerivedData/
# Generated by XcodeGen from project.yml, except the SwiftPM pins (Package.resolved), which XcodeGen preserves and
# which are committed so every build resolves the same package versions.
*.xcodeproj/*
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
.build/
xcuserdata/
.claude/worktrees/

# Never commit signing certificates or private keys (docs/releasing.md)
*.p12
*.pem
*.key
